# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=polaris

# Server Configuration
PORT=3016

# Authentication (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=generate_a_long_random_string_here

# Application URLs
BETTER_AUTH_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# Optional: Additional CORS origins (comma-separated if multiple)
CORS_ORIGIN=

# Optional: OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap (used by scripts/seed.js; falls back to built-in defaults)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=choose_a_strong_password


# Notifications - outbound Telegram / Melipayamak alerts (optional)
# NOTE: All values below are FALLBACKS only. The primary source is the
# workshop settings UI (تبیینات تنظیمات → اطلاع‌رسانی) which stores
# credentials in the database; once an admin saves settings there,
# DB values win and these env entries are ignored.

# Telegram Bot API: create a bot with @BotFather, then chat with it once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# HTTP(S) proxy for reaching api.telegram.org from servers where Telegram
# is blocked (e.g. Iran). Only used for Telegram requests; Melipayamak is
# domestic and never proxied. HTTP/HTTPS proxies only — no SOCKS support.
TELEGRAM_PROXY_URL=
# Melipayamak: UI credentials are the API key (console key OR legacy panel
# password — same field) and the sender line (خط ارسال).
# MELIPAYAMAK_USERNAME = sender line used as `from` for both endpoints.
# MELIPAYAMAK_PANEL_USERNAME = legacy panel login (rest.payamak-panel.com),
# distinct from the sender line; needed only for the legacy fallback path.
MELIPAYAMAK_API=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PANEL_USERNAME=

#frontend
# API URL - Leave empty for same-origin (recommended)
# Dev uses Vite proxy, production assumes same-origin
# Only set if API is on a different domain
VITE_API_URL=


#github action
RESTART_PATH=/PolarisStyle/tmp/
FRONTEND_PATH=/PolarisStyle/public/
BACKEND_PATH=/PolarisStyle/